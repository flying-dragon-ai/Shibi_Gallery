{
  "name": "shibi-gallery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:mobile\"",
    "dev:api": "cross-env NODE_OPTIONS=--no-experimental-require-module pnpm --dir apps/api dev",
    "dev:mobile": "pnpm --dir apps/mobile dev:mp-weixin",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "pnpm --dir apps/api db:migrate",
    "db:seed": "pnpm --dir apps/api db:seed",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "type-check": "pnpm -r type-check",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
